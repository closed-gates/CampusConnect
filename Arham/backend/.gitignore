# ============================================================
# CampusConnect Backend – .gitignore
# ============================================================

# Maven build output
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Application properties with real credentials (use env vars instead)
application-prod.properties.local

# IDE files
.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
.vscode/

# OS files
.DS_Store
Thumbs.db

# Log files
*.log
logs/

# Environment files (never commit real secrets)
.env
.env.local
.env.production

# Maven wrapper (JAR is committed intentionally)
# .mvn/wrapper/maven-wrapper.jar ← intentionally tracked
