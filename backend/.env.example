# ── Neon PostgreSQL ─────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>/neondb?sslmode=require&channel_binding=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=

# ── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
